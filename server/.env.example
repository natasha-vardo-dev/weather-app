# With NODE_ENV=production (the VM's systemd unit sets it) or on Render (RENDER=true) the server checks these settings at start
# and refuses to start with an unsafe one (src/config.ts): PROXY_SECRET and TRUST_PROXY required,
# IP_SELF_LOOKUP forbidden, every secret at least 32 characters (openssl rand -base64 32).
PORT=3001
# Address to listen on (127.0.0.1 behind a proxy on the same machine; the VM's unit sets it).
# Empty: all interfaces.
LISTEN_HOST=
# The deployed commit, shown by /api/health; written by deploy/oracle/deploy.sh, not set by hand.
# GIT_COMMIT=
# Comma-separated list of allowed frontend origins (local development; in production the site
# calls the API through its own origin, so leave it unset there)
CORS_ORIGIN=http://localhost:5173
# How long forecasts are cached, in seconds (a positive number; the server refuses to start otherwise)
FORECAST_CACHE_TTL=900
# Identifies the app to OpenStreetMap Nominatim (place names for the user's location).
# Its usage policy requires an app name and a contact or project URL.
NOMINATIM_USER_AGENT=weather-app/1.0 (+https://github.com/natasha-vardo-dev/weather-app)
# Proxies in front of the server that set X-Forwarded-For (Caddy on the VM: 1), so the
# approximate location uses the user's IP. Leave empty locally.
TRUST_PROXY=
# Shared with the frontend's proxy (Vercel middleware, client/middleware.ts), which sends it in
# X-Proxy-Secret: requests without it are refused (404), so nobody can call this server
# directly with a forged X-Forwarded-For. Set the same value on Vercel and the VM (/etc/weather-api.env). Leave empty
# locally (the Vite proxy does not send it). A long random string; a SECRET.
PROXY_SECRET=
# Local development only: requests come from localhost, so the approximate location looks
# up this machine's own public address. Never set it on a server: it would offer the data
# centre's city to everyone.
IP_SELF_LOOKUP=1
# Push notifications about weather warnings (optional; without them the app has no bell).
# The JSON key of a Firebase service account, as one line or base64. A SECRET: never commit it.
# With it the server also keeps its operational state in the project's Firestore (ADR 0018).
FIREBASE_SERVICE_ACCOUNT=
# Guards POST /api/internal/alerts/notify, which an external scheduler (cron-job.org) calls
# every 5 minutes with "Authorization: Bearer <secret>". A long random string; a SECRET.
ALERTS_NOTIFY_SECRET=
# Guards GET /api/internal/metrics ("Authorization: Bearer <secret>"): cache hit rates and
# provider usage against its limits. Optional; a SECRET. Without it the endpoint does not exist.
METRICS_SECRET=
# info by default; debug logs every call to a provider.
LOG_LEVEL=info
