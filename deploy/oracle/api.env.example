# The API's settings on the VM: copied by setup.sh to /etc/weather-api.env (root only, mode
# 600). Fill in, then: sudo bash /opt/weather-app/deploy/oracle/deploy.sh
# NODE_ENV, PORT and LISTEN_HOST are fixed in weather-api.service (lines here do not change
# them); leave out CORS_ORIGIN and IP_SELF_LOOKUP. Every setting: server/.env.example.
# One value per line, no quotes. Secrets: openssl rand -base64 48

# The same value as PROXY_SECRET on Vercel. A SECRET.
PROXY_SECRET=
# Caddy, on this machine, is the one proxy that sets X-Forwarded-For.
TRUST_PROXY=1
NOMINATIM_USER_AGENT=weather-app/1.0 (+https://github.com/natasha-vardo-dev/weather-app)

# Push notifications (optional): the Firebase service account key in base64, and the
# scheduler's secret. SECRETS.
FIREBASE_SERVICE_ACCOUNT=
ALERTS_NOTIFY_SECRET=

# Optional: enables GET /api/internal/metrics. A SECRET.
METRICS_SECRET=
LOG_LEVEL=info
