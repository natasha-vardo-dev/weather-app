PORT=3001
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# How long forecasts are cached, in seconds (a positive number; the server refuses to start otherwise)
FORECAST_CACHE_TTL=600
# Identifies the app to OpenStreetMap Nominatim (place names for the user's location).
# Its usage policy requires an app name and a contact or project URL.
NOMINATIM_USER_AGENT=weather-app/1.0 (+https://github.com/natasha-vardo-dev/weather-app)
