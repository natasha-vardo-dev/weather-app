# Leave empty when the API is served from the same domain:
# - in development Vite proxies /api to localhost:3001
# - in production vercel.json rewrites /api to the backend
# Set only if the frontend must call the API on another domain directly.
VITE_API_URL=
# Push notifications about weather warnings (optional; without them there is no bell).
# From Firebase Console → Project settings → General (web app) and → Cloud Messaging →
# Web Push certificates. Public by design: they identify the project, they grant nothing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
